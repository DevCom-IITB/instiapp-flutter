<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mess_menu_widget"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/round_background"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- Header row -->
    <LinearLayout
        android:id="@+id/header_row"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginBottom="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/header_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="start"
            android:text="Mess Menu"
            android:textColor="#FF15202D"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/header_logo"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:adjustViewBounds="true"
            android:scaleType="centerInside"
            android:src="@drawable/instiappnew" />

    </LinearLayout>

    <!-- Main content: tabs on left, blue card on right -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- Left: meal tab buttons, each takes equal share of full height -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginEnd="8dp"
            android:orientation="vertical">

            <Button
                android:id="@+id/btn_breakfast"
                android:layout_width="100dp"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginBottom="3dp"
                android:background="@drawable/meal_button_background"
                android:gravity="center"
                android:insetBottom="0dp"
                android:insetTop="0dp"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="Breakfast"
                android:textAllCaps="false"
                android:textColor="#CC0F1620"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_lunch"
                android:layout_width="100dp"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginBottom="3dp"
                android:background="@drawable/meal_button_background"
                android:gravity="center"
                android:insetBottom="0dp"
                android:insetTop="0dp"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="Lunch"
                android:textAllCaps="false"
                android:textColor="#CC0F1620"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_snacks"
                android:layout_width="100dp"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginBottom="3dp"
                android:background="@drawable/meal_button_background"
                android:gravity="center"
                android:insetBottom="0dp"
                android:insetTop="0dp"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="Snacks"
                android:textAllCaps="false"
                android:textColor="#CC0F1620"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_dinner"
                android:layout_width="100dp"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/meal_button_background"
                android:gravity="center"
                android:insetBottom="0dp"
                android:insetTop="0dp"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="Dinner"
                android:textAllCaps="false"
                android:textColor="#CC0F1620"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- Right: blue card with inner white box + doodle strip -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/mess_card_background"
            android:orientation="vertical"
            android:padding="3dp">

            <!-- Inner white box for menu text -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/menu_text_background"
                android:orientation="vertical"
                android:padding="10dp">

                <!-- Hidden meal name label (kept for Java compatibility) -->
                <TextView
                    android:id="@+id/meal_name_text_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#FF1B3252"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <ListView
                    android:id="@+id/meal_list_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:divider="@null"
                    android:dividerHeight="0dp"
                    android:scrollbars="none" />

            </LinearLayout>

            <!-- Time strip: doodle background only for now -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:background="@drawable/doodletime" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>